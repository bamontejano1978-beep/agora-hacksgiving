# Copia a .env (que está en .gitignore) o usa `fly secrets set`.

# --- LLM -------------------------------------------------------------------
# Opcion A: clave directa de OpenRouter (no la subas al repo).
OPENROUTER_API_KEY=
# Opcion B: gateway del connector de OpenRouter en un Sprite. Si pones esto y
# dejas la clave vacia, la credencial se queda fuera de la maquina.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AGORA_MODELO=openrouter/free
# Vacio = usa el LLM si hay clave o gateway. "off" lo desactiva.
AGORA_LLM=

# --- Servicios -------------------------------------------------------------
URL_TRABAJADOR=http://127.0.0.1:8001
URL_TESTIGO=http://127.0.0.1:8002
HOST=127.0.0.1
# PORT lo pone cada servicio por su cuenta (8000/8001/8002) si no lo defines.

# --- Demo ------------------------------------------------------------------
# 1 = zona DNS de demo local: el trabajador "publica" el reto TXT sin dominio real
AGORA_DEMO=1

# --- Persistencia (en Fly con volumen: /data) -------------------------------
JOBS_FILE=datos/jobs.json
PEDIDOS_FILE=datos/pedidos.json
DEMO_DNS_FILE=datos/demo_dns.json

# Resolver DNS alternativo ("host" o "host:puerto"). Vacio = el del sistema.
AGORA_DNS_SERVIDOR=

# --- Matchmaker ------------------------------------------------------------
PESO_REPUTACION=0.55
PESO_PRECIO=0.30
PESO_TIEMPO=0.15
TIEMPO_REFERENCIA_MIN=120
PRECIO_MAX_DEFECTO=12
